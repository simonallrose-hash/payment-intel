# Copy to .env and fill in. Never commit .env (NFR-S-06).
# All values are empty on purpose; defaults for non-secret settings live in
# src/payintel/core/settings.py (NFR-M-02).

# --- Postgres (AS-16) ---
PAYINTEL_POSTGRES__DSN=
# --- ClickHouse (AS-16) ---
PAYINTEL_CLICKHOUSE__URL=
PAYINTEL_CLICKHOUSE__USER=
PAYINTEL_CLICKHOUSE__PASSWORD=
# --- Redis (rate limits, caches) ---
PAYINTEL_REDIS__URL=
# --- S3-compatible object storage (MinIO) ---
PAYINTEL_S3__ENDPOINT=
PAYINTEL_S3__ACCESS_KEY=
PAYINTEL_S3__SECRET_KEY=
PAYINTEL_S3__BUCKET_ARTIFACTS=
PAYINTEL_S3__BUCKET_EXPORTS=
PAYINTEL_S3__REGION=

# --- Secrets ---
# 32 random bytes, base64 (python -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())")
PAYINTEL_SECRETS__ENCRYPTION_KEY=
# Pepper for API-key hashing (NFR-S-02)
PAYINTEL_SECRETS__API_KEY_PEPPER=
# Reserved (sessions are server-side, see ADR-0017)
PAYINTEL_SECRETS__SESSION_SECRET=
# Telegram Bot API token for alerts (AS-19)
PAYINTEL_SECRETS__TELEGRAM_BOT_TOKEN=
# OpenSanctions commercial API key for sanctions screening (FR-KYC-03); empty = screening disabled
PAYINTEL_SECRETS__OPENSANCTIONS_API_KEY=

# --- API / portal (FR-API-07, FR-UI-04; defaults in settings.py) ---
# PAYINTEL_API__METHODOLOGY_URL=         # public URL of docs/methodology (FR-API-10)
# PAYINTEL_API__COOKIE_SECURE=           # false only for http://localhost
# PAYINTEL_API__TOTP_ISSUER=
# PAYINTEL_IDENTITY__CANARY_ZONE=        # DNS zone under company control for canary domains (FR-EX-05)
# PAYINTEL_ALERTS__DIGEST_HOUR_UTC=

# --- Identity of the crawler (LR-02) ---
PAYINTEL_IDENTITY__COMPANY_DOMAIN=
PAYINTEL_IDENTITY__BOT_PAGE_URL=
# Phone used in synthetic identities where no fictional range exists (FR-CW-05)
PAYINTEL_IDENTITY__COMPANY_PHONE=

# --- Checkout scanner (FR-CW-01/10; defaults in settings.py) ---
# PAYINTEL_CHECKOUT__HEADLESS=           # true | false (no stealth either way)
# PAYINTEL_CHECKOUT__CONCURRENCY_PER_WORKER=
# PAYINTEL_CHECKOUT__EGRESS_COUNTRY=     # country of the crawler's own addresses (FR-CW-11)
# PAYINTEL_CHECKOUT__GEO_PROXIES=        # JSON {"FR": "http://user:pass@host:port"}; geolocation only (LR-03)

# --- Crawl politeness after hoster complaints (FR-OO-04; defaults in settings.py) ---
# PAYINTEL_SCAN__ASN_TABLE_PATH=         # ip2asn TSV (iptoasn.com), gz or plain
# PAYINTEL_SCAN__COMPLAINT_RPS_FACTOR=
# PAYINTEL_SCAN__COMPLAINT_ASN_RPS=

# --- Compliance (FR-KYC-03/06; defaults in settings.py) ---
# PAYINTEL_COMPLIANCE__REKYC_INTERVAL_DAYS=
# PAYINTEL_COMPLIANCE__REKYC_REMINDER_DAYS=
# PAYINTEL_COMPLIANCE__STAFF_TELEGRAM_CHAT_ID=
# PAYINTEL_COMPLIANCE__SANCTIONS_THRESHOLD=

# --- Anti-abuse (FR-AB-02/03; defaults in settings.py) ---
# PAYINTEL_ABUSE__AUTO_RESTRICT=         # true | false

# --- Docker compose only ---
POSTGRES_PASSWORD=
CLICKHOUSE_PASSWORD=
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
