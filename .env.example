# Copy to .env and fill in. Never commit .env (NFR-S-06).
# All values are empty on purpose; defaults for non-secret settings live in
# src/payintel/core/settings.py (NFR-M-02).

# --- Postgres (AS-16) ---
PAYINTEL_POSTGRES__DSN=
# --- ClickHouse (AS-16) ---
PAYINTEL_CLICKHOUSE__URL=
PAYINTEL_CLICKHOUSE__USER=
PAYINTEL_CLICKHOUSE__PASSWORD=
# --- Redis (rate limits, caches) ---
PAYINTEL_REDIS__URL=
# --- S3-compatible object storage (MinIO) ---
PAYINTEL_S3__ENDPOINT=
PAYINTEL_S3__ACCESS_KEY=
PAYINTEL_S3__SECRET_KEY=
PAYINTEL_S3__BUCKET_ARTIFACTS=
PAYINTEL_S3__BUCKET_EXPORTS=
PAYINTEL_S3__REGION=

# --- Secrets ---
# 32 random bytes, base64 (python -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())")
PAYINTEL_SECRETS__ENCRYPTION_KEY=
# Pepper for API-key hashing (NFR-S-02)
PAYINTEL_SECRETS__API_KEY_PEPPER=
# Session signing secret (portal, stage 3)
PAYINTEL_SECRETS__SESSION_SECRET=
# Telegram Bot API token for alerts (AS-19, stage 3)
PAYINTEL_SECRETS__TELEGRAM_BOT_TOKEN=

# --- Identity of the crawler (LR-02) ---
PAYINTEL_IDENTITY__COMPANY_DOMAIN=
PAYINTEL_IDENTITY__BOT_PAGE_URL=
# Phone used in synthetic identities where no fictional range exists (FR-CW-05)
PAYINTEL_IDENTITY__COMPANY_PHONE=

# --- Checkout scanner (FR-CW-01/10; defaults in settings.py) ---
# PAYINTEL_CHECKOUT__HEADLESS=           # true | false (no stealth either way)
# PAYINTEL_CHECKOUT__CONCURRENCY_PER_WORKER=

# --- Docker compose only ---
POSTGRES_PASSWORD=
CLICKHOUSE_PASSWORD=
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
