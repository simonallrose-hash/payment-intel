{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "country_signals.yaml",
  "type": "object",
  "required": ["version", "weights", "cctld", "currency", "currency_symbols", "lang", "phone", "country_names"],
  "additionalProperties": false,
  "$defs": {
    "iso": { "type": "string", "pattern": "^[A-Z]{2}$" },
    "isoList": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/iso" } }
  },
  "properties": {
    "version": { "type": "integer", "minimum": 1 },
    "weights": {
      "type": "object",
      "required": ["cctld", "currency", "lang", "hreflang", "schema_address", "phone", "hosting_ip"],
      "additionalProperties": false,
      "properties": {
        "cctld": { "type": "number" }, "currency": { "type": "number" }, "lang": { "type": "number" },
        "hreflang": { "type": "number" }, "schema_address": { "type": "number" },
        "phone": { "type": "number" }, "hosting_ip": { "type": "number" }
      }
    },
    "cctld": { "type": "object", "minProperties": 20, "additionalProperties": { "$ref": "#/$defs/iso" } },
    "currency": { "type": "object", "minProperties": 10, "propertyNames": { "pattern": "^[A-Z]{3}$" }, "additionalProperties": { "$ref": "#/$defs/isoList" } },
    "currency_symbols": { "type": "object", "additionalProperties": { "type": "string", "pattern": "^[A-Z]{3}$" } },
    "lang": { "type": "object", "minProperties": 10, "additionalProperties": { "$ref": "#/$defs/isoList" } },
    "phone": { "type": "object", "minProperties": 10, "propertyNames": { "pattern": "^[0-9]{1,4}$" }, "additionalProperties": { "$ref": "#/$defs/iso" } },
    "country_names": { "type": "object", "additionalProperties": { "$ref": "#/$defs/iso" } }
  }
}
