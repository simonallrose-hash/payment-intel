{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "stop_reasons.yaml",
  "type": "object",
  "required": ["version", "steps", "any_step", "requires_detail"],
  "additionalProperties": false,
  "properties": {
    "version": { "type": "integer", "minimum": 1 },
    "steps": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "pattern": "^[a-z_]{2,32}$" },
      "additionalProperties": {
        "type": "array",
        "minItems": 1,
        "items": { "type": "string", "pattern": "^[a-z0-9_]{2,64}$" }
      }
    },
    "any_step": { "type": "array", "items": { "type": "string", "pattern": "^[a-z0-9_]{2,64}$" } },
    "requires_detail": { "type": "array", "items": { "type": "string", "pattern": "^[a-z0-9_]{2,64}$" } }
  }
}
