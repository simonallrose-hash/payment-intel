{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "test_payment_values.yaml",
  "type": "object",
  "required": ["version", "cards", "preferred", "expiry", "cvc", "holder_name", "client_side_tokenizers"],
  "additionalProperties": false,
  "properties": {
    "version": { "type": "integer", "minimum": 1 },
    "cards": {
      "type": "object",
      "required": ["documented", "luhn_invalid"],
      "additionalProperties": false,
      "properties": {
        "documented": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["number", "brand", "source"],
            "additionalProperties": false,
            "properties": {
              "number": { "type": "string", "pattern": "^[0-9]{12,19}$" },
              "brand": { "type": "string", "pattern": "^[a-z_]{2,32}$" },
              "source": { "type": "string", "pattern": "^https://" }
            }
          }
        },
        "luhn_invalid": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "pattern": "^[0-9]{12,19}$" }
        }
      }
    },
    "preferred": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^[0-9]{12,19}$" } },
    "expiry": {
      "type": "object",
      "required": ["month", "year_offset_years"],
      "additionalProperties": false,
      "properties": {
        "month": { "type": "string", "pattern": "^(0[1-9]|1[0-2])$" },
        "year_offset_years": { "type": "integer", "minimum": 1, "maximum": 10 }
      }
    },
    "cvc": {
      "type": "object",
      "required": ["default", "amex"],
      "additionalProperties": false,
      "properties": {
        "default": { "type": "string", "pattern": "^[0-9]{3}$" },
        "amex": { "type": "string", "pattern": "^[0-9]{4}$" }
      }
    },
    "holder_name": { "type": "string", "minLength": 3, "maxLength": 64 },
    "client_side_tokenizers": { "type": "array", "items": { "type": "string", "pattern": "^[a-z0-9_]{2,64}$" } }
  }
}
