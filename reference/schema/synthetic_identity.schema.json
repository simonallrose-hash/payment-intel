{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "synthetic_identities/<country>.yaml",
  "type": "object",
  "required": ["version", "country", "locale", "first_names", "last_names", "phone", "addresses"],
  "additionalProperties": false,
  "properties": {
    "version": { "type": "integer", "minimum": 1 },
    "country": { "type": "string", "pattern": "^[A-Z]{2}$" },
    "locale": { "type": "string", "pattern": "^[a-z]{2}(-[A-Z]{2})?$" },
    "first_names": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 2, "maxLength": 40 } },
    "last_names": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 2, "maxLength": 40 } },
    "phone": {
      "type": "object",
      "required": ["kind"],
      "additionalProperties": false,
      "properties": {
        "kind": { "enum": ["fictional_range", "company"] },
        "numbers": { "type": "array", "items": { "type": "string", "pattern": "^\\+[0-9 ]{6,20}$" } },
        "source": { "type": "string" }
      }
    },
    "addresses": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["street", "house_number", "postcode", "city"],
        "additionalProperties": false,
        "properties": {
          "street": { "type": "string", "minLength": 2 },
          "house_number": { "type": "string", "minLength": 1 },
          "postcode": { "type": "string", "minLength": 3 },
          "city": { "type": "string", "minLength": 2 },
          "region": { "type": "string" },
          "region_code": { "type": "string" },
          "note": { "type": "string" }
        }
      }
    }
  }
}
