{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "providers.yaml",
  "type": "object",
  "required": ["version", "providers"],
  "additionalProperties": false,
  "properties": {
    "version": { "type": "integer", "minimum": 1 },
    "providers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "name", "role", "status"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9_]{2,64}$" },
          "name": { "type": "string", "minLength": 1, "maxLength": 128 },
          "aliases": { "type": "array", "items": { "type": "string", "minLength": 1 } },
          "role": {
            "enum": ["gateway", "wallet", "bnpl", "local_method_provider", "orchestrator", "fraud_tool", "3ds_sdk"]
          },
          "owner_company": { "type": ["string", "null"], "maxLength": 256 },
          "parent_provider_id": { "type": ["string", "null"], "pattern": "^[a-z0-9_]{2,64}$" },
          "countries": { "type": "array", "items": { "type": "string", "pattern": "^[A-Z]{2}$" } },
          "website": { "type": ["string", "null"], "pattern": "^https://" },
          "status": { "enum": ["active", "acquired", "closed", "deprecated"] },
          "notes": { "type": ["string", "null"] }
        }
      }
    }
  }
}
