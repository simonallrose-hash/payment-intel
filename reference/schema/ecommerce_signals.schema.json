{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ecommerce_signals.yaml",
  "type": "object",
  "required": ["version", "add_to_cart_phrases", "product_paths", "cart_paths", "checkout_paths", "currency_markers", "schema_org_types", "weights"],
  "additionalProperties": false,
  "properties": {
    "version": { "type": "integer", "minimum": 1 },
    "add_to_cart_phrases": { "type": "array", "minItems": 10, "items": { "type": "string", "minLength": 2 } },
    "product_paths": { "type": "array", "minItems": 3, "items": { "type": "string", "minLength": 2 } },
    "cart_paths": { "type": "array", "minItems": 5, "items": { "type": "string", "minLength": 2 } },
    "checkout_paths": { "type": "array", "minItems": 5, "items": { "type": "string", "minLength": 2 } },
    "currency_markers": { "type": "array", "minItems": 3, "items": { "type": "string", "minLength": 1 } },
    "schema_org_types": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "weights": {
      "type": "object",
      "required": ["platform", "schema_org", "add_to_cart", "cart_path", "checkout_path", "currency"],
      "additionalProperties": false,
      "properties": {
        "platform": { "type": "number", "minimum": 0, "maximum": 1 },
        "schema_org": { "type": "number", "minimum": 0, "maximum": 1 },
        "add_to_cart": { "type": "number", "minimum": 0, "maximum": 1 },
        "cart_path": { "type": "number", "minimum": 0, "maximum": 1 },
        "checkout_path": { "type": "number", "minimum": 0, "maximum": 1 },
        "currency": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    }
  }
}
