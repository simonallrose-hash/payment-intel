{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "hosted_checkouts.yaml",
  "type": "object",
  "required": ["version", "hosts"],
  "additionalProperties": false,
  "properties": {
    "version": { "type": "integer", "minimum": 1 },
    "hosts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["host", "provider_id", "status", "source"],
        "additionalProperties": false,
        "properties": {
          "host": { "type": "string", "pattern": "^([a-z0-9-]+\\.)+[a-z]{2,}$" },
          "path_prefix": { "type": "string", "pattern": "^/[A-Za-z0-9_./-]*$" },
          "provider_id": { "type": "string", "pattern": "^[a-z0-9_]{2,64}$" },
          "status": { "type": "string", "enum": ["verified", "needs_verification"] },
          "source": { "type": "string", "pattern": "^https://" },
          "note": { "type": "string", "maxLength": 300 }
        }
      }
    }
  }
}
