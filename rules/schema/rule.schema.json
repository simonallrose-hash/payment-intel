{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "detection rule file (FR-DT-01, FR-DT-02)",
  "type": "object",
  "required": ["target_type", "target_id", "rules"],
  "additionalProperties": false,
  "properties": {
    "target_type": { "enum": ["provider", "payment_method", "platform", "tech"] },
    "target_id": { "type": "string", "pattern": "^[a-z0-9_]{2,64}$" },
    "source": { "type": "string", "description": "Where the signatures come from (official docs URL)" },
    "rules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "version", "signal_type", "pattern", "weight", "enabled"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9_]+(\\.[a-z0-9_]+)+$" },
          "version": { "type": "integer", "minimum": 1 },
          "signal_type": {
            "enum": ["script_src", "network_host", "iframe_src", "js_global", "html_pattern", "form_action", "checkout_label", "platform_plugin", "header", "cookie", "favicon"]
          },
          "pattern": { "type": "string", "minLength": 1, "maxLength": 1024 },
          "match": { "enum": ["host_suffix", "url_contains", "regex", "exact", "header_name", "cookie_name", "sha256"], "default": "host_suffix" },
          "weight": { "type": "number", "minimum": 0, "maximum": 1 },
          "page_scope": { "enum": ["any", "homepage", "product", "cart", "checkout"], "default": "any" },
          "enabled": { "type": "boolean" },
          "needs_verification": { "type": "boolean", "default": false },
          "note": { "type": "string" }
        }
      }
    }
  }
}
