# Reverse proxy with automatic TLS (NFR-S-01). SITE_ADDRESS is "localhost" in dev
# (internal CA, HTTPS only) and the public hostname in production (ACME).
{$SITE_ADDRESS}

encode zstd gzip

# NFR-S-01: TLS 1.2 is the floor, TLS 1.3 preferred; older protocols are never offered.
tls {
    protocols tls1.2 tls1.3
}

header {
    Strict-Transport-Security "max-age=31536000; includeSubDomains"
    X-Content-Type-Options "nosniff"
    X-Frame-Options "DENY"
    Referrer-Policy "no-referrer"
    -Server
}

# Static assets of the portal may be cached; everything else is `no-store`
# (set by the application).
@static path /static/*
header @static Cache-Control "public, max-age=86400"

# The application reads the first X-Forwarded-For hop for IP allow-lists and
# the audit log (FR-API-06, FR-AB-01); Caddy sets it from the TCP peer.
reverse_proxy {$API_UPSTREAM} {
    header_up X-Forwarded-For {remote_host}
    header_up X-Request-Id {http.request.uuid}
}
